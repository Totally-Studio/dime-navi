rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: check if user is the content sync service account
    function isSyncService() {
      return isAuthenticated()
        && request.auth.token.email == 'navi-content-sync@dimesociety.org';
    }

    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's outputs subcollection
      match /outputs/{outputId} {
        allow read, write: if isOwner(userId);
      }

      // User's chat history subcollection
      match /chatHistory/{chatId} {
        allow read, write: if isOwner(userId);
      }

      // User's bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Knowledge base collections - read-only for authenticated users
    match /knowledgeBase/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via console
    }

    match /knowledgebase_wp/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via console
    }

    match /knowledgebase_htg/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via console
    }

    // Timestamped knowledge base collections (matches all knowledgebase_wp_* collections)
    match /{collection}/{docId} {
      allow read: if isAuthenticated() && collection.matches('knowledgebase_wp_.*');
      allow create, update: if isSyncService() && collection.matches('knowledgebase_wp_.*');
      // Allow citationId updates from any authenticated user
      allow update: if isAuthenticated() && collection.matches('knowledgebase_wp_.*')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['citationId']);
    }

    // Knowledge base configuration
    match /knowledgebase_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSyncService();
    }

    // AI logs - authenticated users can write their own logs
    // SECURITY: Validate userId matches auth UID and enforce document size limit
    match /ai_logs/{logId} {
      allow read: if isSyncService();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'timestamp', 'type'])
        && request.resource.size() < 50000;
      allow update, delete: if false; // Logs are immutable
    }

    // Prompt metrics - authenticated users can write their own metrics
    // SECURITY: Validate userId matches auth UID and enforce document size limit
    match /prompt_metrics/{metricId} {
      allow read: if isSyncService();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'query', 'model'])
        && request.resource.size() < 100000;
      allow update, delete: if false; // Metrics are immutable
    }
  }
}
