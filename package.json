{
  "name": "navi-widget",
  "private": true,
  "version": "2026.02.03",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.navi-widget.ts --port 3000",
    "build": "vite build --config vite.config.navi-widget.ts",
    "build:widget:dev": "vite build --config vite.config.navi-widget.ts",
    "build:widget:prod": "vite build --config vite.config.navi-widget.ts --mode client",
    "deploy:dev": "npm run build:widget:dev && firebase deploy --only hosting --project dimenotesv2",
    "deploy:prod": "npm run build:widget:prod && firebase deploy --only hosting --project navi-production-485916",
    "deploy:firestore:prod": "firebase deploy --only firestore --project navi-production-485916",
    "fetch:wp": "node scripts/fetchWordPressContent.cjs",
    "fetch:wp:dev": "node scripts/fetchAndSaveWordPress.cjs dev",
    "fetch:wp:prod": "node scripts/fetchAndSaveWordPress.cjs prod",
    "fetch:firestore": "node scripts/fetchFirestoreData.cjs",
    "upload:wp:dev": "node scripts/uploadToFirestore.cjs dev knowledgebase_wp_2026-02-03",
    "upload:wp:prod": "node scripts/uploadToFirestore.cjs prod knowledgebase_wp_2026-02-03",
    "sync:wp:dev": "node scripts/syncWordPressToFirestore.cjs dev",
    "sync:wp:prod": "node scripts/syncWordPressToFirestore.cjs prod",
    "switch:collection": "node scripts/switchCollection.cjs prod",
    "switch:collection:dev": "node scripts/switchCollection.cjs dev",
    "compare:collections": "node scripts/compareCollections.cjs",
    "compare:datasets": "node scripts/compareDatasets.cjs",
    "analyze:content": "node scripts/analyzeContentChanges.cjs",
    "fetch:metrics": "node scripts/fetchPromptMetrics.cjs",
    "fetch:metrics:dev": "node scripts/fetchPromptMetrics.cjs dev",
    "fetch:metrics:prod": "node scripts/fetchPromptMetrics.cjs prod",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:unit:ui": "vitest --ui tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.28.0",
    "@genkit-ai/googleai": "^1.28.0",
    "@google/genai": "^1.27.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.8.0",
    "genkit": "^1.28.0",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "react-toastify": "^11.0.5",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "streaming-markdown": "^0.2.15",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.11",
    "happy-dom": "^20.0.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.11"
  }
